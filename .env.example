# ProwlLog Environment Configuration Template
# Copy this file to .env.local to configure custom overrides

# Optional: CARTO Basemaps API Key
# Free for evaluation and non-commercial development.
# Sign up at https://carto.com/ to obtain an API key for high-volume production.
# Leave blank to use CARTO's default direct raster endpoint.
# VITE_CARTO_API_KEY=your_carto_api_key_here
